#!/bin/bash
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
if [ "$(id -u)" -eq 0 ]; then
  CONSOLE_USER=$(stat -f %Su /dev/console)
  case "$CONSOLE_USER" in root|loginwindow|"") echo "BG3 MetalFX: log into your Mac before installing." >&2; exit 1;; esac
  CONSOLE_UID=$(id -u "$CONSOLE_USER")
  # Only macOS Installer runs this dispatcher as root. All installation work drops
  # to the logged-in user, with the correct home and GUI bootstrap namespace.
  STAGE=$(mktemp -d /private/tmp/bg3metalfx-install.XXXXXX)
  trap 'rm -rf "$STAGE"' EXIT
  # The Installer sandbox may be root-only. Copy to a private directory owned by
  # the target user before dropping privileges, then always remove that staging copy.
  /usr/bin/ditto --norsrc "$HERE" "$STAGE"
  /usr/sbin/chown -R "$CONSOLE_UID":staff "$STAGE"
  /bin/chmod 700 "$STAGE"
  /bin/launchctl asuser "$CONSOLE_UID" /usr/bin/sudo -H -u "$CONSOLE_USER" -- "$STAGE/bg3mf_installer" install --payload "$STAGE"
  exit $?
fi
exec "$HERE/bg3mf_installer" install --payload "$HERE"
